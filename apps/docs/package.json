{
	"name": "coral-docs",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#lib/components/coral/*": "coral/lib/components/coral/*",
		"#lib/components/ui/*": "coral/lib/components/ui/*",
		"#lib/utils.js": "coral/lib/utils.js"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm --filter coral registry && rm -rf static/r .svelte-kit/cloudflare && cp -R ../../packages/coral/dist/r static/r && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "rm -rf .svelte-kit/cloudflare .svelte-kit/output && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "vitest --run"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.48.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@svmd/content": "^0.2.0",
		"@svmd/core": "^0.2.0",
		"@svmd/vite": "^0.2.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"coral": "workspace:*",
		"mode-watcher": "^1.1.0",
		"shiki": "^4.5.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0",
		"yaml": "^2.9.1"
	}
}
