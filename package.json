{
	"name": "coral",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm registry && rm -rf .svelte-kit/cloudflare && wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"worker:deploy": "wrangler deploy",
		"worker:version": "wrangler versions upload",
		"prepare": "husky && (svelte-kit sync || echo '')",
		"check": "rm -rf .svelte-kit/cloudflare .svelte-kit/output && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"registry": "node scripts/build-registry.js",
		"smoke": "node scripts/smoke-install.js",
		"test": "vitest --run",
		"test:unit": "vitest",
		"gen": "wrangler types",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#docs/*": "./src/docs/*",
		"#assets/*": "./src/assets/*"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.48.0",
		"bits-ui": "^2.18.1",
		"cn": "^0.4.0",
		"embla-carousel-svelte": "^8.6.0",
		"formsnap": "^2.0.1",
		"layerchart": "^2.2.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-variants": "^3.3.1",
		"vaul-svelte": "1.0.0-next.7"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "latest",
		"@fontsource-variable/inter": "^5.3.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@svmd/content": "^0.2.0",
		"@svmd/core": "^0.2.0",
		"@svmd/vite": "^0.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/hast": "^3.0.5",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"axe-core": "^4.13.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"shiki": "^4.4.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix --no-warn-ignored",
			"prettier --write"
		],
		"*.{json,css,md}": "prettier --write"
	}
}
