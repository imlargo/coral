{
	"name": "coral-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter coral-docs dev",
		"build": "pnpm --filter coral-docs build",
		"preview": "pnpm --filter coral-docs preview",
		"worker:deploy": "pnpm --filter coral-docs exec wrangler deploy",
		"worker:version": "pnpm --filter coral-docs exec wrangler versions upload",
		"registry": "pnpm --filter coral registry",
		"check": "pnpm -r check",
		"test": "pnpm -r test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "latest",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix --no-warn-ignored",
			"prettier --write"
		],
		"*.{json,css,md}": "prettier --write"
	}
}
